{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/prices/*", "*.{svg,png,json,webmanifest,js,css}"]
  },
  "routes": [
    { "route": "/prices/*/latest.json", "headers": { "cache-control": "public, max-age=300, must-revalidate" } },
    { "route": "/prices/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/assets/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "cache-control": "no-cache" } }
  ],
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
    "referrer-policy": "no-referrer",
    "x-content-type-options": "nosniff",
    "permissions-policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
